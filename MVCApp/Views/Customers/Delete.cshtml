@model Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>
<h3 class="text-danger">Are you sure you want to delete this customer?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Phone)</dt>
    <dd class="col-sm-10">@Model.Phone</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.City)</dt>
    <dd class="col-sm-10">@Model.City</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
