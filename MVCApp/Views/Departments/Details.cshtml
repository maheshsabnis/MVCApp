@model Department
@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DeptNo)</dt>
    <dd class="col-sm-10">@Model.DeptNo</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DeptName)</dt>
    <dd class="col-sm-10">@Model.DeptName</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Location)</dt>
    <dd class="col-sm-10">@Model.Location</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.DeptNo" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
