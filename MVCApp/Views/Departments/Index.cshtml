@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Dept No</th>
            <th>Dept Name</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.DeptNo</td>
            <td>@d.DeptName</td>
            <td>@d.Location</td>
            <td>
                <a asp-action="Details" asp-route-id="@d.DeptNo">Details</a> |
                <a asp-action="Edit" asp-route-id="@d.DeptNo">Edit</a> |
                <a asp-action="Delete" asp-route-id="@d.DeptNo">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
