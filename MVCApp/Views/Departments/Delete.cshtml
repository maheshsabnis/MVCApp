@model Department
@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>
<h3 class="text-danger">Are you sure you want to delete this department?</h3>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DeptNo)</dt>
    <dd class="col-sm-10">@Model.DeptNo</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DeptName)</dt>
    <dd class="col-sm-10">@Model.DeptName</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Location)</dt>
    <dd class="col-sm-10">@Model.Location</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.DeptNo" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
