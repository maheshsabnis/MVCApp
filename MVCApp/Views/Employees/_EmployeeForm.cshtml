@model Employee
@{
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
}

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EmpNo : null)" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EmpNo" class="form-label"></label>
        @if (isEdit)
        {
            <input asp-for="EmpNo" class="form-control" readonly />
        }
        else
        {
            <input asp-for="EmpNo" class="form-control" />
        }
        <span asp-validation-for="EmpNo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EmpName" class="form-label"></label>
        <input asp-for="EmpName" class="form-control" />
        <span asp-validation-for="EmpName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Salary" class="form-label"></label>
        <input asp-for="Salary" class="form-control" />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeptName" class="form-label"></label>
        <select asp-for="DeptName" class="form-select" asp-items="(SelectList)ViewBag.Departments">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DeptName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Designation" class="form-label"></label>
        <input asp-for="Designation" class="form-control" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
